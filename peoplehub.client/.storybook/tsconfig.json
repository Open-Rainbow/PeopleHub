{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "types": ["node"],
    "typeRoots": ["../node_modules/@types", "../node_modules"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": [
    "./*.ts",
    "../src/**/*.stories.ts",
    "../src/**/*.story.ts",
    "../src/**/*.mdx"
  ],
  "exclude": [
    "../src/**/*.spec.ts"
  ]
}
