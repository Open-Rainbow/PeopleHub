{
  "name": "peoplehub.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "run-script-os",
    "prebuild": "npm run validate:standards",
    "build": "ng build",
    "prebuild:lib": "npm run validate:standards",
    "build:lib": "node scripts/run-project-target.mjs build",
    "prebuild:libs": "npm run validate:standards",
    "build:libs": "node scripts/run-target-all.mjs build libs",
    "prebuild:app": "npm run validate:standards",
    "build:app": "ng build peoplehub.client",
    "run:app:build": "ng run peoplehub.client:build",
    "build:apps": "node scripts/run-target-all.mjs build apps",
    "validate:structure": "node scripts/validate-structure-rules.mjs",
    "validate:angular-guidelines": "node scripts/validate-angular-guidelines.mjs",
    "validate:standards": "npm run validate:structure && npm run validate:angular-guidelines",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run peoplehub.client:storybook",
    "run:lib": "node scripts/run-project-target.mjs storybook",
    "run:libs": "node scripts/run-target-all.mjs storybook libs",
    "storybook:app": "ng run peoplehub.client:storybook",
    "storybook:lib": "node scripts/run-project-target.mjs storybook",
    "storybook:libs": "node scripts/run-target-all.mjs storybook libs",
    "build-storybook": "ng run peoplehub.client:build-storybook",
    "build-storybook:app": "ng run peoplehub.client:build-storybook",
    "build-storybook:lib": "node scripts/run-project-target.mjs build-storybook",
    "build-storybook:libs": "node scripts/run-target-all.mjs build-storybook libs",
    "prestart": "node aspnetcore-https",
    "start:windows": "ng serve --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\" --host=127.0.0.1",
    "start:default": "ng serve --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\" --host=127.0.0.1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@iconify-icons/tabler": "^1.2.95",
    "@iconify/icons-ci": "^1.2.9",
    "@iconify/icons-clarity": "^1.2.8",
    "@iconify/icons-fluent": "^1.2.38",
    "@iconify/icons-fluent-mdl2": "^1.2.1",
    "@iconify/icons-heroicons": "^1.2.9",
    "@iconify/icons-ic": "^1.2.13",
    "@iconify/icons-icon-park-outline": "^1.2.11",
    "@iconify/icons-lucide": "^1.2.135",
    "@iconify/icons-material-symbols": "^1.2.58",
    "@iconify/icons-mdi": "^1.2.48",
    "@iconify/icons-mingcute": "^1.2.9",
    "@iconify/icons-radix-icons": "^1.2.9",
    "@iconify/icons-streamline": "^1.2.3",
    "@iconify/icons-system-uicons": "^1.2.7",
    "@iconify/icons-uil": "^1.2.3",
    "chart.js": "^4.5.1",
    "iconify-icon": "^3.0.2",
    "jest-editor-support": "*",
    "run-script-os": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@storybook/angular": "10.3.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "jsdom": "^28.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.0.0",
    "storybook": "10.3.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.0",
    "vitest": "^4.0.8"
  }
}