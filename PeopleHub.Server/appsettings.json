{
  "ConnectionStrings": {
    "PeopleHubDb": "Server=(localdb)\\MSSQLLocalDB;Database=PeopleHub;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ConnectionStringName": "PeopleHubDb",
    "CommandTimeoutSeconds": 30
  },
  "Organization": {
    "ClaimType": "org_id",
    "HeaderName": "X-Organization-Id",
    "DefaultOrganizationId": null
  },
  "Authentication": {
    "Jwt": {
      "Enabled": false,
      "Issuer": "PeopleHub",
      "Audience": "PeopleHub.Client",
      "SigningKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:58993",
      "https://localhost:58993"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
